{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orch-extras-mgmt",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  // scheduled ハンドラを公開するため、既定のエントリではなく自前の server.ts を使う
  "main": "src/server.ts",
  "observability": {
    "enabled": true
  },
  // directory はビルド時に Vite プラグインが入れるのでここには書かない。
  // 画面は SPA シェルを assets から返し、Worker はサーバ関数だけを受ける。
  // こうしないと document ごとに Worker が描画してしまう（設計書5章）
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/_serverFn/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orch-extras-mgmt",
      "database_id": "ecb47f2a-47d2-42fe-ac21-6434bce2f6ae",
      "migrations_dir": "migrations"
    }
  ]
}
