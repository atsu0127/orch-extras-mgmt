{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orch-extras-mgmt",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  // Workers の env を Start の fetch オプションと誤認させないラッパーを使う
  "main": "src/server.ts",
  "observability": {
    "enabled": true
  },
  // 空なら Anthropic 直結。本番の id 投入は docs/observability/design.md 9章
  "vars": {
    "AI_GATEWAY_ACCOUNT_ID": "",
    "AI_GATEWAY_ID": ""
  },
  // directory はビルド時に Vite プラグインが入れるのでここには書かない。
  // 画面は SPA シェルを assets から返し、Worker はサーバ関数だけを受ける。
  // こうしないと document ごとに Worker が描画してしまう（設計書5章）
  // ANTHROPIC_API_KEY は wrangler secret（ローカルは .dev.vars）
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/_serverFn/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orch-extras-mgmt",
      "database_id": "ecb47f2a-47d2-42fe-ac21-6434bce2f6ae",
      "migrations_dir": "migrations"
    }
  ]
}
