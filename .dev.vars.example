# ローカル開発用の secret。.dev.vars にコピーして使う（.dev.vars は git 管理外）。
# 本番へは wrangler secret put で設定する。詳細は docs/platform/design.md の環境変数節。

# パスワードハッシュ用の pepper。変更すると既存のパスワードが検証できなくなる
PASSWORD_PEPPER=local-development-pepper

# pnpm db:seed が投入する初期パスワード
ADMIN_INITIAL_PASSWORD=local-admin-password
EXTRA_INITIAL_PASSWORD=local-extra-password

# AI案内。ローカルと CI は決定的スタブを使う（1）。実 Claude API の確認時は
# ASSISTANT_STUB を外し、ANTHROPIC_API_KEY にキーを入れる。
ASSISTANT_STUB=1
ANTHROPIC_API_KEY=

# 本番の実 Claude だけ AI Gateway 経由にする（docs/observability/design.md）。
# ローカル既定のスタブでは不要。実 API を Gateway 経由で試すときだけ入れる。
# TOKEN は secret。3つ揃ったときだけ経由する。
AI_GATEWAY_ACCOUNT_ID=
AI_GATEWAY_ID=
AI_GATEWAY_TOKEN=
